<!-- CSS to enable smooth animation -->
<style>
  #scrollNavbar {
    position: fixed;
    top: 0; /* Place it at the very top */
    left: 0; /* Start from the left edge */
    width: 100%; /* Full-width navbar */
    height: auto; /* Auto height for horizontal layout */
    padding: 10px; /* Add some padding */
    display: flex; /* Use flexbox for horizontal alignment */
    justify-content: space-evenly; /* Distribute items evenly */
    align-items: center; /* Center items vertically */
    background: rgba(0, 0, 0, 0.8); /* Semi-transparent background */
    border-bottom: 2px solid white; /* Optional border at the bottom */
    z-index: 20; /* Ensure it's above other elements */
    transform: translateY(-100%); /* Initially hidden */
    opacity: 0; /* Fully transparent initially */
    transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
  }
  
  /* Show scrollNavbar only for small screens */
  @media (min-width: 768px) {
    #scrollNavbar {
      display: none; /* Hide on medium and larger screens */
    }
  }
  
  #scrollNavbar.show {
    transform: translateY(0); /* Slide down to visible position */
    opacity: 1; /* Fully visible */
  }
  
  
</style>

<script>
  let lastScrollTop = 0;
const navbar = document.getElementById("scrollNavbar");

window.addEventListener("scroll", function () {
  let scrollTop = window.pageYOffset || document.documentElement.scrollTop;

  if (scrollTop > lastScrollTop) {
    // Scroll down, show navbar
    navbar.classList.add("show");
  } else {
    // Scroll up, hide navbar
    navbar.classList.remove("show");
  }

  lastScrollTop = scrollTop;
});

</script>