<% layout("/layouts/boilerplate.ejs")%>

    <body class="overflow-x-hidden bg-black ">
        <%- include("../includes/sidebar.ejs")%>

            <% if (error && error.length) { %>
                <div
                    class="fixed flex justify-between w-3/4 px-4 text-red-700 transform -translate-x-1/2 bg-red-100 border border-red-400 rounded shadow-lg alert alert-error top-5 left-1/2 md:w-1/2 lg:w-1/3">
                    <span>
                        <%= error %>
                    </span>
                    <button onclick="this.parentElement.style.display='none'"
                        class="ml-2 font-bold text-red-600 hover:text-red-800">&times;</button>
                </div>
                <% } %>
                    <% if (success && success.length) { %>
                        <div
                            class="fixed flex items-center justify-between w-3/4 px-4 py-3 space-x-3 text-green-800 transform -translate-x-1/2 bg-green-500 border border-green-400 rounded shadow-lg top-5 left-1/2 md:w-1/2 lg:w-1/3">
                            <span class="font-semibold">
                                <%= success %>
                            </span>
                            <button onclick="this.parentElement.style.display='none'"
                                class="ml-2 text-lg font-bold text-green-600 hover:text-green-800">&times;</button>
                        </div>
                        <% } %>
                            <main class="flex flex-col items-center justify-center w-full m-5 my-5 text-white">
                                <h1 class="px-8 py-4 mb-5 text-4xl font-bold ">Project Requests</h1>
                                <%if(requestArray.length>0){%>
                                    <ul class="flex flex-col w-10/12 m-8 list-none gap-y-3">
                                        <%for(let i=0;i<requestArray.length;i++){%>
                                            <li class="flex w-full p-3 border-2 border-white bg-grey-800 rounded-xl">
                                                <div class="flex w-full p-2 gap-x-5">
                                                    <img src="/images/user (1).png" class="h-6" alt="">
                                                    <span class="text-xl font-medium text-white">
                                                        <%=requestArray[i].user%>
                                                    </span>
                                                    <div class="my-5 mt-0 rating">
                                                        <input type="radio" name="rating-2"
                                                            class="bg-orange-400 mask mask-star-2" disabled />
                                                        <input type="radio" name="rating-2"
                                                            class="bg-orange-400 mask mask-star-2" disabled />
                                                        <input type="radio" name="rating-2"
                                                            class="bg-orange-400 mask mask-star-2" disabled />
                                                        <input type="radio" name="rating-2"
                                                            class="bg-orange-400 mask mask-star-2" disabled />
                                                        <input type="radio" name="rating-2"
                                                            class="bg-orange-400 mask mask-star-2" disabled
                                                            checked="checked" />
                                                    </div>
                                                    <span class="text-xl">|</span>
                                                    <span class="text-xl font-medium">
                                                        <%=requestArray[i].projectName%>
                                                    </span>
                                                </div>
                                                <div class="flex items-center justify-center px-2 mb-5 mr-3 gap-x-4">
                                                    <!-- Accept Button -->

                                                    <a href="/accept/<%=requestArray[i].Pid%>/<%=requestArray[i].projectId%>"
                                                        class="flex items-center justify-center w-full p-1 px-5 rounded-2xl hover:bg-gray-700">
                                                        <img src="/images/check-mark.png" class="w-6">
                                                        <span class="ml-2 text-lg font-medium text-white ">Accept</span>
                                                    </a>

                                                    <!-- Reject Button -->
                                                    <a href="/reject/<%=requestArray[i].Pid%>/<%=requestArray[i].projectId%>"
                                                        class="flex items-center justify-center w-full p-1 px-5 rounded-full hover:bg-gray-700">
                                                        <img src="/images/close (1).png" class="w-6 h-5">
                                                        <span class="ml-2 text-lg font-medium text-white">Reject</span>
                                                    </a>
                                                </div>


                                            </li>
                                            <%}%>
                                    </ul>
                                    <%}else{%>
                                        <div class="flex items-center justify-center w-full min-h-screen p-28">
                                            <h1
                                                class="p-2 mb-20 font-sans text-6xl font-bold text-center text-transparent bg-gradient-to-r from-blue-500 via-green-500 to-purple-500 bg-clip-text">
                                                No Requests Currently
                                            </h1>
                                        </div>
                                        <%}%>



                            </main>
    </body>

    </html>