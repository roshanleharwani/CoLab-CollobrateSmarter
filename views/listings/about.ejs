<% layout("/layouts/boilerplate.ejs")%>

  <body onclick="toggleSidebarOnBody(event) " class="w-full min-h-screen bg-black" data-scroll-container>
    <video autoplay muted loop playsinline
      class="fixed bottom-0 right-0 object-cover w-auto h-auto min-w-full min-h-full -z-10">
      <source src="YOUR_VIDEO_URL" type="video/mp4">
    </video>
    <%- include("../includes/sidebar.ejs")%>
      <!-- Content -->
      <main class="relative z-10 w-full max-w-3xl p-6 mx-auto text-white">
        <div class="space-y-12">
          <!-- Who We Are -->
          <section class="mt-20 space-y-6">
            <h1 class="text-5xl font-bold text-transparent bg-gradient-to-r from-purple-400 to-pink-600 bg-clip-text">
              Bridging Dreams, Building Teams
            </h1>

            <p class="text-xl leading-relaxed text-gray-300">
              We're a group of former college students who experienced firsthand the challenge of finding the right
              teammates for hackathons and startup ventures. This struggle inspired us to create something meaningful
              for
              the student community.
            </p>
          </section>

          <!-- Our Story -->
          <section class="p-8 space-y-6 backdrop-blur-lg bg-white/5 rounded-2xl">
            <h2 class="text-3xl font-semibold text-purple-400">Our Story</h2>
            <p class="text-lg leading-relaxed text-gray-300">
              It all started in a cramped dorm room during our final year of college. After participating in countless
              hackathons and attempting several startup ideas, we realized that the biggest hurdle wasn't the technical
              challenges – it was finding the right people to work with.
            </p>
            <p class="text-lg leading-relaxed text-gray-300">
              We saw brilliant ideas die because developers couldn't find designers, and innovative solutions fade away
              because business minds couldn't connect with technical talent. That's when we decided to build TeamUp
              Campus.
            </p>
          </section>

          <!-- Our Mission -->
          <section class="space-y-6">
            <h2 class="text-3xl font-semibold text-purple-400">Why We Built This</h2>
            <div class="grid gap-6 md:grid-cols-2">
              <div class="p-6 backdrop-blur-lg bg-white/5 rounded-xl">
                <h3 class="mb-3 text-xl font-semibold text-pink-400">For Innovation</h3>
                <p class="text-gray-300">
                  We believe every college student with an innovative idea deserves the chance to bring it to life. Your
                  next big project shouldn't fail because you couldn't find the right teammate.
                </p>
              </div>
              <div class="p-6 backdrop-blur-lg bg-white/5 rounded-xl">
                <h3 class="mb-3 text-xl font-semibold text-pink-400">For Community</h3>
                <p class="text-gray-300">
                  We're building more than a platform – we're cultivating a community where students can connect,
                  collaborate, and create together, regardless of their college or location.
                </p>
              </div>
            </div>
          </section>

          <!-- Vision -->
          <section class="p-8 space-y-6 backdrop-blur-lg bg-white/5 rounded-2xl">
            <h2 class="text-3xl font-semibold text-purple-400">Looking Forward</h2>
            <p class="text-lg leading-relaxed text-gray-300">
              Our vision extends beyond just matching teammates. We're creating an ecosystem where college students can
              find mentorship, resources, and opportunities to grow together. Whether you're a coder, designer,
              marketer,
              or visionary, there's a place for you here.
            </p>
            <p class="text-lg leading-relaxed text-gray-300">
              We're not just another platform – we're your partners in turning those late-night project ideas into
              reality. Because we believe that when the right minds connect, amazing things happen.
            </p>
          </section>

          <!-- Call to Action -->
          <div class="pt-8 text-center">
            <p class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
              Ready to find your dream team?
            </p>
          </div>
        </div>
      </main>
  </body>