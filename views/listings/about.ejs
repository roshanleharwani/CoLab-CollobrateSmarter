<% layout("/layouts/boilerplate.ejs")%>

  <body onclick="toggleSidebarOnBody(event) " class="w-full min-h-screen bg-black">
    <main class="flex flex-col items-center justify-center">
      <%- include("../includes/sidebar.ejs")%>
        <section
          class="relative w-full min-h-screen about-section bg-gradient-to-br from-purple-900 via-indigo-950 to-gray-950">
          <!-- Animated background particles -->
          <div class="absolute inset-0">
            <div id="particles-js" class="absolute inset-0"></div>
          </div>

          <!-- Content -->
          <div class="relative z-10 flex flex-col items-center justify-center w-full h-full px-4 py-16 text-white">
            <div
              class="mb-8 text-5xl font-extrabold text-center text-transparent md:text-5xl my-14 bg-clip-text bg-gradient-to-r from-yellow-400 via-red-500 to-pink-500 animate-gradient-x">
              Revolutionizing Tech Collaboration
            </div>

            <div class="max-w-5xl mx-auto space-y-12">
              <p class="text-2xl font-light text-center md:text-3xl">
                We're not just a platform; we're a launchpad for your tech dreams.
              </p>

              <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
                <div
                  class="p-6 transition duration-500 transform rounded-lg bg-white/10 backdrop-blur-md hover:scale-105 hover:rotate-1">
                  <h2 class="mb-4 text-2xl font-semibold text-yellow-300">Our Vision</h2>
                  <p>Imagine a world where every student's innovative idea finds its perfect team. That's the world
                    we're building.</p>
                </div>
                <div
                  class="p-6 transition duration-500 transform rounded-lg bg-white/10 backdrop-blur-md hover:scale-105 hover:-rotate-1">
                  <h2 class="mb-4 text-2xl font-semibold text-green-300">What Sets Us Apart</h2>
                  <ul class="space-y-2 list-none">
                    <li class="flex items-center"><span class="mr-2 text-pink-400">&#9733;</span> AI-powered team
                      matching</li>
                    <li class="flex items-center"><span class="mr-2 text-pink-400">&#9733;</span> Virtual hackathon
                      spaces</li>
                    <li class="flex items-center"><span class="mr-2 text-pink-400">&#9733;</span> Skill-based challenges
                    </li>
                    <li class="flex items-center"><span class="mr-2 text-pink-400">&#9733;</span> Mentor connections
                    </li>
                  </ul>
                </div>
                <div
                  class="p-6 transition duration-500 transform rounded-lg bg-white/10 backdrop-blur-md hover:scale-105 hover:rotate-1">
                  <h2 class="mb-4 text-2xl font-semibold text-blue-300">Impact</h2>
                  <p>Join 10,000+ students who've launched projects, won competitions, and landed dream internships
                    through our platform.</p>
                </div>
              </div>

              <div class="mt-12 text-center">
                <h2 class="mb-6 text-3xl font-bold text-cyan-300">Ready to Elevate Your Tech Journey?</h2>
                <p class="mb-8 text-xl">Don't just dream about innovation – make it happen.</p>
                <a href="/signup"
                  class="inline-block px-8 py-4 text-xl font-semibold text-white transition duration-300 ease-in-out transform rounded-full bg-gradient-to-r from-indigo-700 to-purple-800 hover:-translate-y-1 hover:shadow-lg hover:shadow-purple-500/50 hover:scale-105">
                  Join the Revolution
                </a>
              </div>
            </div>
          </div>

          <!-- Interactive Element: Floating Tech Icons -->
          <div class="absolute inset-0 pointer-events-none">
            <i class="absolute text-4xl fas fa-code text-white/20 top-1/4 left-1/4 animate-float"></i>
            <i class="absolute text-5xl fas fa-laptop-code text-white/20 top-3/4 left-1/3 animate-float-delayed"></i>
            <i class="absolute text-4xl fas fa-brain text-white/20 top-1/3 right-1/4 animate-float"></i>
            <i class="absolute text-5xl fas fa-robot text-white/20 bottom-1/4 right-1/3 animate-float-delayed"></i>
          </div>
        </section>

        <!-- Particle.js for animated background -->
        <script src="https://cdn.jsdelivr.net/npm/particles.js@2.0.0/particles.min.js"></script>
        <script>
          particlesJS("particles-js", {
            particles: {
              number: { value: 80, density: { enable: true, value_area: 800 } },
              color: { value: "#ffffff" },
              shape: { type: "circle" },
              opacity: { value: 0.5, random: false },
              size: { value: 3, random: true },
              line_linked: { enable: true, distance: 150, color: "#ffffff", opacity: 0.4, width: 1 },
              move: { enable: true, speed: 6, direction: "none", random: false, straight: false, out_mode: "out", bounce: false }
            },
            interactivity: {
              detect_on: "canvas",
              events: { onhover: { enable: true, mode: "repulse" }, onclick: { enable: true, mode: "push" }, resize: true },
              modes: { repulse: { distance: 100, duration: 0.4 }, push: { particles_nb: 4 } }
            },
            retina_detect: true
          });
        </script>

        <style>
          @keyframes float {

            0%,
            100% {
              transform: translateY(0);
            }

            50% {
              transform: translateY(-20px);
            }
          }

          @keyframes floatDelayed {

            0%,
            100% {
              transform: translateY(0);
            }

            50% {
              transform: translateY(-20px);
            }
          }

          .animate-float {
            animation: float 6s ease-in-out infinite;
          }

          .animate-float-delayed {
            animation: floatDelayed 6s ease-in-out infinite;
            animation-delay: 3s;
          }

          .animate-gradient-x {
            background-size: 200% 200%;
            animation: gradientPosition 5s ease infinite;
          }

          @keyframes gradientPosition {
            0% {
              background-position: 0% 50%;
            }

            50% {
              background-position: 100% 50%;
            }

            100% {
              background-position: 0% 50%;
            }
          }
        </style>
    </main>
  </body>