<% layout("/layouts/boilerplate.ejs")%>

  <body class="bg-gray-900 bg-gradient-to-r from-indigo-500">
    <section class="flex items-center justify-center w-full m-y-5">
      <%- include("../includes/sidebar.ejs")%>

        <div class="items-center justify-center hidden w-1/2 md:flex">
          <img src="/images/register-removebg-preview.png" alt="" class="object-fill w-full">
        </div>

        <div
          class="   md:w-full border-white shadow border-[1px] p-2 rounded-xl dark:border md:mt-0 sm:w-5/6  xl:w-2/5  backdrop-blur-xl dark:bg-gray-800 dark:border-gray-700">
          <!-- Set max-w-lg or any other width class to control the width -->
          <div class="p-4 space-y-4 md:space-y-6 sm:p-4">
            <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
              Enter Details of Your Project
            </h1>
            <form class="space-y-4 md:space-y-6" id="projectForm" action="/teamRegistration" method="POST">
              <div class="flex gap-3">
                <div class="w-full">
                  <label for="project-name" class="block mb-2 text-lg font-medium text-gray-900 dark:text-white"><strong
                      class="mr-2 space-x-3 text-xl text-red-500">*</strong>Your
                    Name</label>
                  <input type="text" name="project[person_name]" id="person_name" placeholder="Andrew Tate"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                    required="" />
                </div>
                <div class="w-full">
                  <label for="project[name]" class="block mb-2 text-lg font-medium text-gray-900 dark:text-white">
                    <strong class="mr-2 space-x-3 text-xl text-red-500">*</strong>Project
                    Name</label>
                  <input type="text" name="project[name]" id="project_name"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                    placeholder="Website Creation" required="" />
                </div>
              </div>
              <div>
                <label for="project-description"
                  class="block mb-2 text-lg font-medium text-gray-900 dark:text-white"><strong
                    class="mr-2 space-x-3 text-xl text-red-500">*</strong>Project
                  Description</label>
                <textarea name="project[description]" id="project-description"
                  class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 resize-none"
                  required=""></textarea>
              </div>
              <div>
                <label for="members" class="block mb-1 text-lg font-medium text-gray-900 dark:text-white">Number
                  of
                  Members Required </label>
                <strong class="my-2 mb-2 text-lg text-red-500">* Range Between
                  [1-10]</strong>
                <input type="number" max="10" min="1" id="members" name="project[members_required]"
                  oninput="enforceRange(this)"
                  class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                  required>
                </input>
              </div>
              <div>
                <div class="">
                  <label for="existing-members" class="block mb-2 text-lg font-medium text-gray-900 dark:text-white">
                    Registration number of existing members
                  </label>
                  <div class="flex items-center justify-center w-full">
                    <input type="text" name="project[existing_members]" id="existing-members" placeholder="23BCEXXXX"
                      class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-s-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 pr-16 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" />
                    <button type="button" id="addBtn"
                      class="h-[50px] px-4 py-0 font-semibold text-white duration-300 ease-in-out bg-blue-600 rounded-r-lg hover:transition-all hover:scale-105 hover:bg-blue-700">
                      Add
                    </button>
                  </div>
                </div>
                <!-- Hidden div to display the list -->
                <div id="registered-list" class="hidden mt-4">
                  <h6 class="text-lg font-semibold text-gray-900 dark:text-white" id="registeredMembers">
                    Registered
                    Members:</h6>
                  <ul id="memberList" class="flex flex-wrap gap-4 pl-0 mt-2 list-none">
                  </ul>
                </div>

              </div>
              <div class="relative">
                <label for="skills" class="block mb-2 text-lg font-medium text-gray-900 dark:text-white">Skills
                  Required</label>
                <div class="flex items-center justify-center">
                  <input type="text" id="project_skills"
                    class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-s-lg focus:ring-primary-600  block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white "
                    placeholder="Website Creation" name="project[skills]" onclick="toggleDropdown()"
                    onfocus="showDropdown()" />
                  <button type="button" id="addSkillBtn"
                    class="bottom-0 right-0 h-[52px] px-4 font-bold text-white bg-green-500 rounded-r-lg hover:bg-green-600"
                    onclick="addSkill()">
                    +
                  </button>
                </div>

                <ul id="skillsDropdown"
                  class="absolute z-20 hidden w-full mt-1 overflow-y-auto bg-white border border-gray-300 rounded-lg shadow-lg max-h-40">
                  <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Web Development')">
                    Web
                    Development</li>
                  <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Graphic Design')">
                    Graphic
                    Design</li>
                  <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Digital Marketing')">
                    Digital Marketing</li>
                  <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Content Writing')">
                    Content
                    Writing</li>
                  <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('SEO')">SEO</li>
                </ul>

                <div id="addedSkills" class="hidden mt-4">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Selected Skills:</h3>
                  <ul id="skillList" class="flex flex-wrap gap-4 pl-0 mt-2 list-none"></ul>
                </div>
              </div>


              <div class="flex justify-center w-full">
                <button type="submit"
                  class="w-3/4 text-black bg-white hover:bg-red-600 hover:text-white font-semibold rounded-lg text-lg px-5 py-2.5 text-center hover:transition-all hover:scale-105 duration-500"
                  onclick="addSkill()">
                  Add Project
                </button>
              </div>
            </form>
          </div>
        </div>
    </section>