<% layout("/layouts/boilerplate.ejs")%>

  <body class="bg-gray-900 bg-gradient-to-r from-indigo-500">
    <main class="flex-1 h-full overflow-visible md:min-w-full md:p-5">
      <!-- sidebar starts here -->
      <%- include("../includes/sidebar.ejs")%>
        <!-- sidebar ends here -->
        <section class="bg-gray-50 dark:bg-transparent pt-14 overflow-x-hidden.">
          <div class="flex items-center justify-between w-full px-6 py-8 md:flex md:justify-center">

            <div
              class="md:w-[80rem] rounded-xl shadow dark:border md:mt-0 sm:w-full  xl:p-0 backdrop-blur-xl dark:bg-gray-800 dark:border-gray-700 max-w-lg">
              <!-- Set max-w-lg or any other width class to control the width -->
              <div class="p-4 space-y-4 md:space-y-6 sm:p-4">
                <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 md:text-2xl dark:text-white">
                  Enter Details of Your Project
                </h1>
                <form class="space-y-4 md:space-y-6" id="projectForm" action="/teamRegistration" method="POST">
                  <div class="flex gap-x-4">

                    <div class="w-full">
                      <label for="project-name"
                        class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Your
                        Name</label>
                      <input type="text" name="project[person_name]" id="person_name" placeholder="Andrew Tate"
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        required="" />
                    </div>
                    <div class="w-full">
                      <label for="email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Project
                        Name</label>
                      <input type="text" name="project[name]" id="project_name"
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        placeholder="Website Creation" required="" />
                    </div>
                  </div>
                  <div class="w-full">
                    <label for="project[phoneNumber]"
                      class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Phone No.</label>
                    <input type="number" name="project[phoneNumber]" id="number"
                      class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                      placeholder="+91 XXXXXXXXX" required="" />
                  </div>
                  <div>
                    <label for="project-description"
                      class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Project
                      Description</label>
                    <textarea name="project[description]" id="project-description"
                      class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 resize-none"
                      required=""></textarea>
                  </div>
                  <div>
                    <label for="members" class="block mb-1 text-lg font-medium text-gray-900 dark:text-white">Number
                      of
                      Members Required </label>
                    <strong class="my-2 mb-2 text-lg text-red-500">* Range Between
                      [1-10]</strong>
                    <input type="number" max="10" min="1" id="members" name="project[members_required]"
                      oninput="enforceRange(this)"
                      class="bg-gray-50 border border-gray-300 text-gray-900 text-lg rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                      required>
                    </input>
                  </div>
                  <div>
                    <div class="">
                      <label for="existing-members"
                        class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">
                        Registration number of existing members
                      </label>
                      <div class="flex items-center justify-center ">

                        <input type="text" name="project[existing_members]" id="existing-members"
                          placeholder="23BCEXXXX"
                          class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 pr-16 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500" />
                        <button type="button" id="addBtn"
                          class="h-[44px]  px-4 py-0 text-white bg-blue-500 hover:bg-blue-600 font-semibold rounded-r-lg">
                          Add
                        </button>
                      </div>
                    </div>
                    <!-- Hidden div to display the list -->
                    <div id="registered-list" class="hidden mt-4">
                      <h6 class="text-lg font-semibold text-gray-900 dark:text-white" id="registeredMembers">Registered
                        Members:</h6>
                      <ul id="memberList" class="flex flex-wrap gap-4 pl-0 mt-2 list-none">
                      </ul>
                    </div>

                  </div>
                  <div class="">
                    <label for="skills" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Skills
                      Required</label>
                    <div class="flex items-center justify-center w-full">
                      <input type="text" id="project_skills"
                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-s-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500"
                        placeholder="Website Creation" name="project[skills]" onclick="toggleDropdown()"
                        onfocus="showDropdown()" />
                      <button type="button" id="addSkillBtn"
                        class="  h-[44px] px-4 text-white bg-green-500 hover:bg-green-600 font-semibold rounded-r-lg"
                        onclick="addSkill()">
                        +
                      </button>
                    </div>

                    <ul id="skillsDropdown"
                      class="absolute z-20 hidden w-full mt-1 overflow-y-auto bg-white border border-gray-300 rounded-lg shadow-lg max-h-40">
                      <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Web Development')">Web
                        Development</li>
                      <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Graphic Design')">Graphic
                        Design</li>
                      <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Digital Marketing')">
                        Digital Marketing</li>
                      <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('Content Writing')">Content
                        Writing</li>
                      <li class="p-2 cursor-pointer hover:bg-gray-100" onclick="selectSkill('SEO')">SEO</li>
                    </ul>

                    <div id="addedSkills" class="hidden mt-4">
                      <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Selected Skills:</h3>
                      <ul id="skillList" class="flex flex-wrap gap-4 pl-0 mt-2 list-none"></ul>
                    </div>
                  </div>


                  <div class="flex justify-center w-full">
                    <button type="submit"
                      class="w-full text-black bg-white hover:bg-red-500 hover:text-white font-semibold rounded-lg text-lg px-5 py-2.5 text-center hover:ring-2 hover:ring-white hover:scale-105 duration-300"
                      onclick="addSkill()">
                      Add Project
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </section>
    </main>
    <script>
      function enforceRange(input) {
        const min = parseInt(input.min, 10);
        const max = parseInt(input.max, 10);
        const value = parseInt(input.value, 10);

        if (value < min) {
          input.value = min; // Set to minimum if below range
        } else if (value > max) {
          input.value = max; // Set to maximum if above range
        }
      }
    </script>