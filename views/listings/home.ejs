<% layout("/layouts/boilerplate.ejs")%>

  <body class="flex flex-col min-h-screen bg-black " onclick="toggleSidebarOnBody(event) ">
    <!-- Header -->

    <main class="relative flex-grow overflow-hidden">
      <!-- sidebar starts here -->
      <%- include("../includes/sidebar.ejs")%>
        <!-- sidebar ends here -->

        <!-- part of the page showing the trending topics starts here -->
        <section class="relative w-full min-h-screen trending">
          <!-- Video Background -->
          <video class="absolute top-0 left-0 object-cover w-full h-full opacity-50" autoplay muted loop playsinline>
            <source src="/images/bg-video.mp4" type="video/mp4">
            Your browser does not support the video tag.
          </video>

          <!-- Overlay -->
          <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-t from-black via-black/70 to-transparent">
          </div>
          <!-- Content -->
          <div class="relative z-10 flex flex-col items-center justify-center w-full h-full text-white">
            <h1 class="mb-8 text-4xl font-semibold text-center mt-36 md:text-6xl">
              Connect . Collaborate . Create
            </h1>
            <p class="max-w-3xl mb-12 text-xl text-center text-gray-300 md:text-2xl">
              Find your perfect team for hackathons, coding competitions, and tech events. Join the largest community of
              student collaborators.
            </p>

            <div class="flex flex-col items-center justify-center gap-5 sm:flex-row">
              <button
                class="w-full px-6 py-3 text-xl font-semibold text-white transition duration-300 ease-in-out bg-indigo-500 rounded-md sm:w-auto hover:-translate-y-1 hover:bg-indigo-600 hover:scale-105">
                Find Events
              </button>
              <div class="hidden text-3xl text-white sm:block">|</div>
              <a href="/competeRegistration" class="w-full sm:w-auto">
                <button
                  class="w-full px-6 py-3 text-xl font-semibold text-white transition duration-300 ease-in-out bg-red-500 rounded-md sm:w-auto hover:-translate-y-1 hover:bg-red-600 hover:scale-105">
                  Create Team
                </button>
              </a>
            </div>
          </div>
        </section>
        <section class="flex flex-col h-screen p-4 bg-gray-950">
          <div class="text-4xl font-semibold text-white">Explore Teams</div>
        </section>

    </main>
  </body>